<%- include("partials/header", { titre: "Déposer ma vidéo — School Voice 2027" }) %>

<div class="wrap">
  <div class="hero">
    <span class="tag">FORMULAIRE DE DÉPÔT</span>
    <h1>Déposez votre vidéo</h1>
    <p class="lead">
      Vidéo de 60 secondes maximum. Vérifiez que votre email et votre numéro
      WhatsApp sont bien actifs : c'est par là que nous vous répondrons.
    </p>
  </div>  <div class="card"><% if (erreur) { %>
  <div class="alert error"><%= erreur %></div>
<% } %>

<form action="/candidature" method="POST" id="formCandidature">

  <div class="field">
    <label for="prenom">Prénom</label>
    <input type="text" id="prenom" name="prenom" required>
  </div>

  <div class="field">
    <label for="nom">Nom</label>
    <input type="text" id="nom" name="nom" required>
  </div>

  <div class="field">
    <label for="zone">Votre zone School Voice</label>
    <select id="zone" name="zone" required>
      <option value="" disabled selected>
        Choisissez votre zone
      </option>

      <% zones.forEach(z => { %>
        <option value="<%= z %>"><%= z %></option>
      <% }) %>
    </select>
  </div>

  <div class="field">
    <label for="email">Adresse email (fonctionnelle)</label>
    <input type="email" id="email" name="email" required>
  </div>

  <div class="field">
    <label for="whatsapp">Numéro WhatsApp (fonctionnel)</label>

    <input
      type="tel"
      id="whatsapp"
      name="whatsapp"
      placeholder="Ex : 22961234567"
      required
    >

    <p class="hint">
      Format international sans le "+", ex : 22961234567.
    </p>
  </div>

  <!-- VIDÉO -->
  <div class="field">

    <label>Votre vidéo — 60 secondes maximum</label>

    <div class="video-drop" id="videoDrop">

      <button
        type="button"
        class="btn gold full"
        id="btnChoisirVideo"
      >
        🎥 Choisir ma vidéo
      </button>

      <p id="videoStatus">
        Cliquez sur le bouton pour sélectionner votre vidéo.
        Formats : MP4, MOV, WebM.
        Taille maximale : <%= tailleMaxMo %> Mo.
      </p>

      <video
        id="videoPreview"
        class="video-preview"
        controls
        playsinline
        preload="metadata"
        style="display:none; width:100%; margin-top:15px;"
      ></video>

    </div>

    <!-- Données Cloudinary -->
    <input
      type="hidden"
      name="video_url"
      id="videoUrl"
    >

    <input
      type="hidden"
      name="video_public_id"
      id="videoPublicId"
    >

    <input
      type="hidden"
      name="video_original_name"
      id="videoOriginalName"
    >

    <input
      type="hidden"
      name="duree"
      id="dureeVideo"
    >

  </div>

  <!-- BOUTON ENVOYER -->
  <button
    type="submit"
    class="btn gold full"
    id="btnEnvoyer"
    disabled
  >
    Envoyer ma candidature
  </button>

  <p
    class="hint"
    id="submitHint"
    style="text-align:center; margin-top:10px;"
  >
    Le bouton s'activera après l'envoi et la vérification de votre vidéo.
  </p>

</form>

  </div>
</div><!-- =========================================
     CLOUDINARY UPLOAD WIDGET
========================================= --><script
  src="https://upload-widget.cloudinary.com/latest/global/all.js"
  type="text/javascript">
</script><script>

  document.addEventListener("DOMContentLoaded", function () {

    const btnChoisirVideo =
      document.getElementById("btnChoisirVideo");

    const btnEnvoyer =
      document.getElementById("btnEnvoyer");

    const preview =
      document.getElementById("videoPreview");

    const statusEl =
      document.getElementById("videoStatus");

    const dropZone =
      document.getElementById("videoDrop");

    const form =
      document.getElementById("formCandidature");

    const videoUrlInput =
      document.getElementById("videoUrl");

    const videoPublicIdInput =
      document.getElementById("videoPublicId");

    const videoOriginalNameInput =
      document.getElementById("videoOriginalName");

    const dureeInput =
      document.getElementById("dureeVideo");

    const submitHint =
      document.getElementById("submitHint");


    /*
     * Vérification du chargement de Cloudinary
     */

    if (
      typeof cloudinary === "undefined"
    ) {

      console.error(
        "❌ Cloudinary Widget n'est pas chargé."
      );

      statusEl.textContent =
        "Impossible de charger le système d'envoi vidéo. Actualisez la page.";

      return;
    }


    /*
     * PARAMÈTRES CLOUDINARY
     */

    const CLOUD_NAME =
      "krylli5g";

    const UPLOAD_PRESET =
      "school_voice_videos";


    /*
     * CRÉATION DU WIDGET
     */

    const myWidget =
      cloudinary.createUploadWidget(

        {

          cloudName: CLOUD_NAME,

          uploadPreset: UPLOAD_PRESET,

          sources: [
            "local"
          ],

          multiple: false,

          maxFiles: 1,

          resourceType: "video",

          clientAllowedFormats: [
            "mp4",
            "mov",
            "webm",
            "m4v"
          ],

          maxFileSize:
            <%= Number(tailleMaxMo || 150) %>
            * 1024
            * 1024,

          language: "fr",

          showAdvancedOptions: false,

          showCompletedButton: false,

          showUploadMoreButton: false,

          singleUploadAutoClose: true

        },


        /*
         * RETOUR CLOUDINARY
         */

        function (error, result) {

          console.log(
            "Cloudinary event :",
            result
          );


          /*
           * ERREUR
           */

          if (error) {

            console.error(
              "❌ Erreur Cloudinary :",
              error
            );

            statusEl.textContent =
              "❌ Erreur pendant l'envoi de la vidéo. Veuillez réessayer.";

            dropZone.classList.add(
              "error"
            );

            btnEnvoyer.disabled =
              true;

            return;
          }


          if (!result) {
            return;
          }


          /*
           * UPLOAD TERMINÉ
           */

          if (
            result.event === "success"
          ) {

            const info =
              result.info || {};

            console.log(
              "✅ Vidéo reçue par Cloudinary :",
              info
            );


            /*
             * URL CLOUDINARY
             */

            const videoUrl =
              info.secure_url || "";


            /*
             * Si Cloudinary n'a pas
             * retourné d'URL
             */

            if (!videoUrl) {

              console.error(
                "❌ Aucune secure_url retournée.",
                info
              );

              statusEl.textContent =
                "La vidéo a été envoyée mais son adresse n'a pas été récupérée. Veuillez réessayer.";

              btnEnvoyer.disabled =
                true;

              return;
            }


            /*
             * DURÉE
             */

            const duree =
              Number(
                info.duration || 0
              );


            /*
             * VIDÉO TROP LONGUE
             */

            if (
              duree &&
              duree > 60.5
            ) {

              statusEl.textContent =
                "❌ Votre vidéo dépasse 60 secondes. Merci de choisir une vidéo plus courte.";

              dropZone.classList.add(
                "error"
              );

              btnEnvoyer.disabled =
                true;

              return;
            }


            /*
             * ENREGISTREMENT
             * DES DONNÉES
             */

            videoUrlInput.value =
              videoUrl;

            videoPublicIdInput.value =
              info.public_id || "";

            videoOriginalNameInput.value =
              info.original_filename ||
              info.public_id ||
              "video";

            dureeInput.value =
              duree
                ? duree.toFixed(1)
                : "";


            /*
             * APERÇU VIDÉO
             */

            preview.src =
              videoUrl;

            preview.style.display =
              "block";


            /*
             * ÉTAT VISUEL
             */

            dropZone.classList.remove(
              "error"
            );

            dropZone.classList.add(
              "has-file"
            );


            /*
             * MESSAGE
             */

            if (duree) {

              statusEl.textContent =
                "✓ Vidéo envoyée avec succès — " +
                duree.toFixed(1) +
                " seconde(s).";

            } else {

              statusEl.textContent =
                "✓ Vidéo envoyée avec succès.";

            }


            /*
             * ACTIVATION DU BOUTON
             */

            btnEnvoyer.disabled =
              false;

            submitHint.textContent =
              "✓ Votre vidéo est prête. Vous pouvez maintenant envoyer votre candidature.";

            submitHint.style.fontWeight =
              "bold";


            console.log(
              "✅ Bouton Envoyer activé."
            );

          }

        }

      );


    /*
     * BOUTON CHOISIR LA VIDÉO
     */

    btnChoisirVideo.addEventListener(
      "click",
      function () {

        /*
         * Réinitialisation
         */

        videoUrlInput.value =
          "";

        videoPublicIdInput.value =
          "";

        videoOriginalNameInput.value =
          "";

        dureeInput.value =
          "";

        preview.removeAttribute(
          "src"
        );

        preview.style.display =
          "none";

        dropZone.classList.remove(
          "error",
          "has-file"
        );

        btnEnvoyer.disabled =
          true;

        submitHint.textContent =
          "Attendez la fin de l'envoi de votre vidéo.";

        statusEl.textContent =
          "Sélectionnez votre vidéo puis attendez la fin de l'envoi...";


        /*
         * OUVERTURE CLOUDINARY
         */

        myWidget.open();

      }
    );


    /*
     * PROTECTION DU FORMULAIRE
     */

    form.addEventListener(
      "submit",
      function (event) {

        if (
          !videoUrlInput.value
        ) {

          event.preventDefault();

          statusEl.textContent =
            "❌ Veuillez d'abord sélectionner et envoyer votre vidéo.";

          alert(
            "Veuillez sélectionner et envoyer votre vidéo avant de continuer."
          );

          return;
        }


        /*
         * Empêcher les doubles clics
         */

        btnEnvoyer.disabled =
          true;

        btnEnvoyer.textContent =
          "Enregistrement de votre candidature…";

      }
    );

  });

</script><%- include("partials/footer") %>
